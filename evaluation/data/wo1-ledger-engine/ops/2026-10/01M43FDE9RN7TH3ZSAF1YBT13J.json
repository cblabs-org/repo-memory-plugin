          "ota.Purpose",
          "ota.Description",
          "internal/core/config/subsystem.go",
          "internal/core/config/subsystem_test.go"
        ],
        "entry_type": "ruled-out",
        "text": "Be careful with `filepath.Match` when writing globs, it behaves differently from shell globs for `**`. Standard `.memory/config.yaml` relies heavily on `**`, so the fallback in `AssignSubsystem` was necessary."
      }
    },
