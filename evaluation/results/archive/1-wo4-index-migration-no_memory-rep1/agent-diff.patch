+func TestAliases(t *testing.T) {
+	dbPath := filepath.Join(t.TempDir(), "test.db")
+	idx, err := index.NewIndex(dbPath)
+	if err != nil {
+		t.Fatalf("NewIndex: %v", err)
+	}
+	defer idx.Close()
+
+	ctx := context.Background()
+
+	// Chain: scope-1 -> scope-2 -> scope-3
+	if err := idx.UpsertAlias(ctx, "scope-1", "scope-2"); err != nil {
+		t.Fatalf("UpsertAlias: %v", err)
+	}
+	if err := idx.UpsertAlias(ctx, "scope-2", "scope-3"); err != nil {
+		t.Fatalf("UpsertAlias: %v", err)
+	}
+
+	r1, err := idx.ResolveAlias(ctx, "scope-1")
+	if err != nil {
+		t.Fatalf("ResolveAlias scope-1: %v", err)
+	}
+	if r1 != "scope-3" {
+		t.Errorf("expected scope-1 -> scope-3, got %s", r1)
+	}
+
+	r2, err := idx.ResolveAlias(ctx, "scope-2")
+	if err != nil {
+		t.Fatalf("ResolveAlias scope-2: %v", err)
+	}
+	if r2 != "scope-3" {
+		t.Errorf("expected scope-2 -> scope-3, got %s", r2)
+	}
+
+	r3, err := idx.ResolveAlias(ctx, "scope-3")
+	if err != nil {
+		t.Fatalf("ResolveAlias scope-3: %v", err)
+	}
+	if r3 != "scope-3" {
+		t.Errorf("expected scope-3 -> scope-3, got %s", r3)
+	}
+
+	// Unaliased returns as-is
+	rUnk, err := idx.ResolveAlias(ctx, "unknown-scope")
+	if err != nil {
+		t.Fatalf("ResolveAlias unknown: %v", err)
+	}
+	if rUnk != "unknown-scope" {
+		t.Errorf("expected unknown-scope -> unknown-scope, got %s", rUnk)
+	}
+
+	// Cycle test: c1 -> c2 -> c1
+	if err := idx.UpsertAlias(ctx, "c1", "c2"); err != nil {
+		t.Fatalf("UpsertAlias: %v", err)
+	}
+	if err := idx.UpsertAlias(ctx, "c2", "c1"); err != nil {
+		t.Fatalf("UpsertAlias: %v", err)
+	}
+	rCycle, err := idx.ResolveAlias(ctx, "c1")
+	if err != nil {
+		t.Fatalf("ResolveAlias cycle: %v", err)
+	}
+	if rCycle != "c1" && rCycle != "c2" {
+		t.Errorf("expected cycle resolution to be c1 or c2, got %s", rCycle)
+	}
+}
