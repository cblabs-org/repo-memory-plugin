+func TestErrorPatterns(t *testing.T) {
+	dbPath := filepath.Join(t.TempDir(), "test.db")
+	idx, err := index.NewIndex(dbPath)
+	if err != nil {
+		t.Fatalf("NewIndex: %v", err)
+	}
+	defer idx.Close()
+
+	ctx := context.Background()
+
+	if err := idx.UpsertEntry(ctx, dossiers.Entry{ID: "fail-1", Type: dossiers.EntryTypeFailureSignature, DossierScope: "git", Text: "gpg failed"}); err != nil {
+		t.Fatalf("UpsertEntry: %v", err)
+	}
+	if err := idx.UpsertEntry(ctx, dossiers.Entry{ID: "fail-2", Type: dossiers.EntryTypeFailureSignature, DossierScope: "npm", Text: "ERESOLVE"}); err != nil {
+		t.Fatalf("UpsertEntry: %v", err)
+	}
+
+	if err := idx.InsertErrorPattern(ctx, "fail-1", "git commit", "error: gpg failed to sign the data", "git"); err != nil {
+		t.Fatalf("InsertErrorPattern: %v", err)
+	}
+	if err := idx.InsertErrorPattern(ctx, "fail-2", "npm install", "ERESOLVE unable to resolve dependency tree", "npm"); err != nil {
+		t.Fatalf("InsertErrorPattern: %v", err)
+	}
+
+	// Lookup with full command
+	results, err := idx.LookupErrorPatterns(ctx, "git commit -m 'feat: initial'")
+	if err != nil {
+		t.Fatalf("LookupErrorPatterns git commit: %v", err)
+	}
+	if len(results) != 1 {
+		t.Fatalf("expected 1 result for git commit, got %d", len(results))
+	}
+	if results[0].EntryID != "fail-1" || results[0].CommandPrefix != "git commit" || results[0].DossierScope != "git" {
+		t.Errorf("unexpected result: %+v", results[0])
+	}
+
+	// Lookup with prefix
+	results, err = idx.LookupErrorPatterns(ctx, "git")
+	if err != nil {
+		t.Fatalf("LookupErrorPatterns git: %v", err)
+	}
+	if len(results) != 1 || results[0].EntryID != "fail-1" {
+		t.Fatalf("expected [fail-1] for git, got %v", results)
+	}
+
+	// Lookup with non-matching
+	results, err = idx.LookupErrorPatterns(ctx, "pytest")
+	if err != nil {
+		t.Fatalf("LookupErrorPatterns pytest: %v", err)
+	}
+	if len(results) != 0 {
+		t.Fatalf("expected 0 results for pytest, got %d", len(results))
+	}
+
+	// Lookup with empty command returns all
+	results, err = idx.LookupErrorPatterns(ctx, "")
+	if err != nil {
+		t.Fatalf("LookupErrorPatterns empty: %v", err)
+	}
+	if len(results) != 2 {
+		t.Fatalf("expected 2 results for empty command, got %d", len(results))
+	}
+}
