+		BatchID:   "batch-01",
+		CreatedAt: now,
+		Ops: []ops.Op{
+			{
+				Type:         ops.OpAdd,
+				EntryID:      "inv-100",
+				DossierScope: "compiler",
+				Timestamp:    now,
+				Source:       ops.SourceTurnNote,
+				Fields: map[string]any{
+					"entry_type": "invariant",
+					"text":       "Compiler must emit source maps",
+					"anchors":    []string{"cmd/compile/main.go", "pkg/codegen"},
+					"verified":   "test:pass",
+				},
+			},
+			{
+				Type:         ops.OpAdd,
+				EntryID:      "fail-100",
+				DossierScope: "build",
+				Timestamp:    now,
+				Source:       ops.SourceSidecar,
+				Fields: map[string]any{
+					"entry_type": "failure-signature",
+					"text":       "out of memory during link phase",
+					"anchors":    []string{"cmd:go build", "pkg/linker"},
+				},
+			},
+		},
+	}
+	if err := writer.Write(batch1); err != nil {
+		t.Fatalf("Write batch1: %v", err)
+	}
+
+	// Batch 2: Retire an entry and Split a dossier
+	batch2 := ops.OpBatch{
+		Version:   1,
+		BatchID:   "batch-02",
+		CreatedAt: now.Add(time.Minute),
+		Ops: []ops.Op{
+			{
+				Type:         ops.OpRetire,
+				EntryID:      "inv-100",
+				DossierScope: "compiler",
+				Timestamp:    now.Add(time.Minute),
+				Source:       ops.SourceHuman,
+				Fields: map[string]any{
+					"reason": "replaced by dynamic maps",
+				},
+			},
+			{
+				Type:         ops.OpSplit,
+				DossierScope: "legacy-compiler",
+				Timestamp:    now.Add(time.Minute),
+				Source:       ops.SourceHuman,
+				Fields: map[string]any{
+					"new_dossiers": []string{"compiler-frontend", "compiler-backend"},
+					"entry_moves": map[string]string{
+						"fail-100": "compiler-backend",
+					},
+				},
+			},
+		},
+	}
+	if err := writer.Write(batch2); err != nil {
+		t.Fatalf("Write batch2: %v", err)
+	}
+
+	reader := ops.NewReader(opsDir)
+
+	dbPath := filepath.Join(t.TempDir(), "index.db")
+	idx, err := index.NewIndex(dbPath)
+	if err != nil {
+		t.Fatalf("NewIndex: %v", err)
+	}
+	defer idx.Close()
+
+	ctx := context.Background()
+	if err := idx.RebuildFromOpLog(ctx, reader); err != nil {
+		t.Fatalf("RebuildFromOpLog: %v", err)
+	}
+
+	// Verify fail-100 exists
+	failEntry, err := idx.GetEntry(ctx, "fail-100")
+	if err != nil {
+		t.Fatalf("GetEntry fail-100: %v", err)
+	}
+	if failEntry.Text != "out of memory during link phase" {
+		t.Errorf("unexpected failEntry text: %s", failEntry.Text)
+	}
+
+	// inv-100 was retired so it should be in history, not active entries
+	_, err = idx.GetEntry(ctx, "inv-100")
+	if !errors.Is(err, index.ErrNotFound) {
+		t.Errorf("expected inv-100 to not be in entries (retired), got %v", err)
+	}
+
+	history, err := idx.GetHistory(ctx, "inv-100")
+	if err != nil {
+		t.Fatalf("GetHistory inv-100: %v", err)
+	}
+	if len(history) != 1 {
+		t.Fatalf("expected 1 history entry for inv-100, got %d", len(history))
+	}
+	if history[0].RetiredReason != "replaced by dynamic maps" {
+		t.Errorf("expected retired reason 'replaced by dynamic maps', got %s", history[0].RetiredReason)
+	}
+
+	// Verify error pattern was created for fail-100
+	patterns, err := idx.LookupErrorPatterns(ctx, "go build")
+	if err != nil {
+		t.Fatalf("LookupErrorPatterns: %v", err)
+	}
+	if len(patterns) != 1 || patterns[0].EntryID != "fail-100" {
+		t.Fatalf("expected 1 pattern for fail-100, got %v", patterns)
+	}
+
+	// Verify alias created from OpSplit
+	resolved, err := idx.ResolveAlias(ctx, "legacy-compiler")
+	if err != nil {
+		t.Fatalf("ResolveAlias: %v", err)
+	}
+	if resolved != "compiler-frontend" {
+		t.Errorf("expected legacy-compiler to resolve to compiler-frontend, got %s", resolved)
+	}
+}
