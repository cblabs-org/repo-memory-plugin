+func TestSearchEntries_FTS5(t *testing.T) {
+	dbPath := filepath.Join(t.TempDir(), "test.db")
+	idx, err := index.NewIndex(dbPath)
+	if err != nil {
+		t.Fatalf("NewIndex: %v", err)
+	}
+	defer idx.Close()
+
+	ctx := context.Background()
+
+	e1 := dossiers.Entry{
+		ID:           "e1",
+		Type:         dossiers.EntryTypeInvariant,
+		DossierScope: "database",
+		Text:         "Postgres connection pool must have maximum 20 connections",
+	}
+	e2 := dossiers.Entry{
+		ID:           "e2",
+		Type:         dossiers.EntryTypeGotcha,
+		DossierScope: "network",
+		Text:         "Redis timeout occurs if latency exceeds 500ms",
+	}
+	e3 := dossiers.Entry{
+		ID:           "e3",
+		Type:         dossiers.EntryTypeFailureSignature,
+		DossierScope: "database",
+		Text:         "Connection pool exhausted error occurs when transactions leak",
+	}
+
+	for _, e := range []dossiers.Entry{e1, e2, e3} {
+		if err := idx.UpsertEntry(ctx, e); err != nil {
+			t.Fatalf("UpsertEntry: %v", err)
+		}
+	}
+
+	results, err := idx.SearchEntries(ctx, "Postgres")
+	if err != nil {
+		t.Fatalf("SearchEntries Postgres: %v", err)
+	}
+	if len(results) != 1 || results[0].ID != "e1" {
+		t.Fatalf("expected [e1] for 'Postgres', got %v", results)
+	}
+
+	results, err = idx.SearchEntries(ctx, "pool")
+	if err != nil {
+		t.Fatalf("SearchEntries pool: %v", err)
+	}
+	if len(results) != 2 {
+		t.Fatalf("expected 2 results for 'pool', got %d", len(results))
+	}
+
+	// Empty query returns empty
+	results, err = idx.SearchEntries(ctx, "")
+	if err != nil {
+		t.Fatalf("SearchEntries empty: %v", err)
+	}
+	if len(results) != 0 {
+		t.Fatalf("expected 0 results for empty query, got %d", len(results))
+	}
+
+	// Deleted entry should not show up
+	if err := idx.DeleteEntry(ctx, "e1"); err != nil {
+		t.Fatalf("DeleteEntry: %v", err)
+	}
+	results, err = idx.SearchEntries(ctx, "Postgres")
+	if err != nil {
+		t.Fatalf("SearchEntries after delete: %v", err)
+	}
+	if len(results) != 0 {
+		t.Fatalf("expected 0 results after deletion, got %d", len(results))
+	}
