+// Server provides MCP pull tools over the SQLite index, op log, and delivery ledger.
 type Server struct {
-	idx *index.Index
+	idx       *index.Index
+	ledger    *delivery.Ledger
+	opsWriter *ops.Writer
+	opsDir    string
+	mu        sync.RWMutex
+}
+
+// ServerOption configures a Server instance.
+type ServerOption func(*Server)
+
+// WithLedger configures the delivery ledger on the Server.
+func WithLedger(l *delivery.Ledger) ServerOption {
+	return func(s *Server) {
+		s.ledger = l
+	}
+}
+
+// WithOpsWriter configures the ops writer on the Server.
+func WithOpsWriter(w *ops.Writer) ServerOption {
+	return func(s *Server) {
+		s.opsWriter = w
+	}
+}
+
+// WithOpsDir configures the ops directory and initializes an ops writer on the Server.
+func WithOpsDir(dir string) ServerOption {
+	return func(s *Server) {
+		s.opsDir = dir
+		s.opsWriter = ops.NewWriter(dir)
+	}
+}
+
+// SetLedger updates the delivery ledger on the Server.
+func (s *Server) SetLedger(l *delivery.Ledger) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.ledger = l
+}
+
+// SetOpsWriter updates the ops writer on the Server.
+func (s *Server) SetOpsWriter(w *ops.Writer) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.opsWriter = w
+}
+
+func (s *Server) getOpsWriter() *ops.Writer {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	if s.opsWriter != nil {
+		return s.opsWriter
+	}
+	if s.opsDir != "" {
+		return ops.NewWriter(s.opsDir)
+	}
+	return nil
+}
+
+func (s *Server) recordPull(entryID string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.ledger != nil && entryID != "" {
+		s.ledger.RecordPull(entryID)
+	}
 }
 
