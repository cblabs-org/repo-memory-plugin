+// NewServer creates a new Server with optional configuration options.
+func NewServer(idx *index.Index, opts ...ServerOption) *Server {
+	s := &Server{
+		idx: idx,
+	}
+	for _, opt := range opts {
+		opt(s)
+	}
+	return s
+}
